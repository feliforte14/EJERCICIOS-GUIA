    <string name="titulo_tareas">Tareas de estudio</string>
    <string name="nueva_tarea">Nueva tarea</string>
    <string name="agregar">Agregar</string>
    <string name="borrar_todas">Borrar todas</string>
    <string name="eliminar">Eliminar</string>
    <!-- %1$d es un argumento: stringResource(R.string.cantidad_tareas, n) reemplaza %1$d por n.
         Así el idioma decide DÓNDE va el número dentro de la frase. -->
    <string name="cantidad_tareas">Tareas: %1$d</string>
</resources>
